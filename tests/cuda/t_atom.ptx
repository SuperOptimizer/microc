// atom and red: every operation, on global and on shared memory, 32 and 64 bits, floats.
//! run one 1 1 1 1 1 1 0 40
//! run many 3 1 1 64 1 1 0 16
.version 8.5
.target sm_86
.address_size 64

// one thread: the value given back and the value left, for each operation
.visible .entry one(.param .u64 out)
{
    .reg .b32 %r<12>;
    .reg .b64 %rd<12>;
    .reg .f32 %f<4>;
    .reg .f64 %d<4>;
    ld.param.u64 %rd1, [out];
    add.u64 %rd2, %rd1, 128;        // word 32: the cell
    mov.u32 %r1, 100;
    st.global.u32 [%rd2], %r1;
    atom.global.add.u32 %r2, [%rd2], 5;          // 100 -> 105
    st.global.u32 [%rd1], %r2;
    atom.global.exch.b32 %r2, [%rd2], 0xf0f0;    // 105 -> f0f0
    st.global.u32 [%rd1+4], %r2;
    atom.global.and.b32 %r2, [%rd2], 0xff00;     // f0f0 -> f000
    st.global.u32 [%rd1+8], %r2;
    atom.global.or.b32 %r2, [%rd2], 0x0f;        // f000 -> f00f
    st.global.u32 [%rd1+12], %r2;
    atom.global.xor.b32 %r2, [%rd2], 0xffff;     // f00f -> 0ff0
    st.global.u32 [%rd1+16], %r2;
    atom.global.cas.b32 %r2, [%rd2], 0x1234, 7;  // no match: stays 0ff0
    st.global.u32 [%rd1+20], %r2;
    atom.global.cas.b32 %r2, [%rd2], 0x0ff0, 7;  // match: 7
    st.global.u32 [%rd1+24], %r2;
    atom.global.inc.u32 %r2, [%rd2], 8;          // 7 -> 8
    st.global.u32 [%rd1+28], %r2;
    atom.global.inc.u32 %r2, [%rd2], 8;          // 8 >= 8 -> 0
    st.global.u32 [%rd1+32], %r2;
    atom.global.dec.u32 %r2, [%rd2], 8;          // 0 -> 8
    st.global.u32 [%rd1+36], %r2;
    atom.global.dec.u32 %r2, [%rd2], 5;          // 8 > 5 -> 5
    st.global.u32 [%rd1+40], %r2;
    atom.global.dec.u32 %r2, [%rd2], 5;          // 5 -> 4
    st.global.u32 [%rd1+44], %r2;
    atom.global.min.u32 %r2, [%rd2], 0xfffffff0; // 4 stays
    st.global.u32 [%rd1+48], %r2;
    atom.global.min.s32 %r2, [%rd2], 0xfffffff0; // -16
    st.global.u32 [%rd1+52], %r2;
    atom.global.max.s32 %r2, [%rd2], 3;          // 3
    st.global.u32 [%rd1+56], %r2;
    atom.global.max.u32 %r2, [%rd2], 0x80000000; // 80000000
    st.global.u32 [%rd1+60], %r2;
    atom.global.add.u32 %r2, [%rd2], 0xffffffff; // 7fffffff   (word 16)
    st.global.u32 [%rd1+64], %r2;
    ld.global.u32 %r2, [%rd2];
    st.global.u32 [%rd1+68], %r2;
    // 64 bits, word 18..
    mov.u64 %rd3, 0xffffffff;
    st.global.u64 [%rd2], %rd3;
    atom.global.add.u64 %rd4, [%rd2], 1;         // 1_00000000
    st.global.u64 [%rd1+72], %rd4;
    atom.global.cas.b64 %rd4, [%rd2], 0x100000000, 0xabcdef0123456789;
    st.global.u64 [%rd1+80], %rd4;
    atom.global.exch.b64 %rd4, [%rd2], 9;
    st.global.u64 [%rd1+88], %rd4;
    atom.global.min.s64 %rd4, [%rd2], -1;
    atom.global.max.u64 %rd4, [%rd2], 5;
    ld.global.u64 %rd4, [%rd2];
    st.global.u64 [%rd1+96], %rd4;
    // floats, word 26..
    mov.f32 %f1, 0f3FC00000;
    st.global.f32 [%rd2], %f1;
    atom.global.add.f32 %f2, [%rd2], 0f40200000; // 1.5 + 2.5
    st.global.f32 [%rd1+104], %f2;
    ld.global.f32 %f2, [%rd2];
    st.global.f32 [%rd1+108], %f2;
    mov.f64 %d1, 0d3FF8000000000000;
    st.global.f64 [%rd2], %d1;
    atom.global.add.f64 %d2, [%rd2], 0d4004000000000000;
    ld.global.f64 %d2, [%rd2];
    st.global.f64 [%rd1+112], %d2;
    // red gives nothing back; generic addressing; word 30, 31
    mov.u32 %r1, 40;
    st.global.u32 [%rd2], %r1;
    red.global.add.u32 [%rd2], 2;
    red.max.u32 [%rd2], 41;
    red.global.min.u32 [%rd2], 100;
    ld.global.u32 %r2, [%rd2];
    st.global.u32 [%rd1+120], %r2;
    red.global.xor.b32 [%rd2], 0xff;
    ld.global.u32 %r2, [%rd2];
    st.global.u32 [%rd1+124], %r2;
    ret;
}

.shared .align 8 .u64 acc[4];

// 3 blocks of 64 threads on the same global cells, and on each block's own shared cells
.visible .entry many(.param .u64 out)
{
    .reg .b32 %r<12>;
    .reg .b64 %rd<12>;
    .reg .f32 %f<4>;
    .reg .pred %p<3>;
    ld.param.u64 %rd1, [out];
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, %ctaid.x;
    mad.lo.u32 %r3, %r2, 64, %r1;                // 0..191
    atom.global.add.u32 %r4, [%rd1], 1;          // 192
    red.global.add.u32 [%rd1+4], %r3;            // 191 * 192 / 2
    add.u32 %r5, %r3, 1000;
    atom.global.max.u32 %r4, [%rd1+8], %r5;      // 1191
    not.b32 %r6, %r3;
    red.global.min.s32 [%rd1+12], %r6;           // -192
    mov.u32 %r7, 1;
    and.b32 %r8, %r3, 31;
    shl.b32 %r7, %r7, %r8;
    red.global.or.b32 [%rd1+16], %r7;            // ffffffff
    red.global.xor.b32 [%rd1+20], %r3;           // the xor of 0..191 = 0
    cvt.rn.f32.u32 %f1, %r3;
    red.global.add.f32 [%rd1+24], %f1;           // 18336.0: exact in any order
    cvt.u64.u32 %rd2, %r3;
    shl.b64 %rd2, %rd2, 28;
    red.global.add.u64 [%rd1+32], %rd2;          // 18336 << 28
    // the block's own cells
    cvt.u64.u32 %rd3, %r1;
    red.shared.add.u64 [acc], %rd3;              // 2016
    red.shared.max.u32 [acc+8], %r5;             // 1063 + 64 * block
    mov.u64 %rd4, acc;
    cvt.u32.u64 %r9, %rd4;
    atom.shared.add.u32 %r10, [%r9+16], 2;       // by a 32-bit address: 128
    bar.sync 0;
    setp.ne.u32 %p1, %r1, 63;
    @%p1 bra $Ldone;
    // the last thread of a block reports at words 10 + 2 * block: acc[0] + acc[2], acc[1]
    ld.shared.u64 %rd5, [acc];
    ld.shared.u32 %r10, [acc+16];
    cvt.u32.u64 %r11, %rd5;
    add.u32 %r11, %r11, %r10;
    mul.wide.u32 %rd6, %r2, 8;
    add.u64 %rd6, %rd6, %rd1;
    st.global.u32 [%rd6+40], %r11;
    ld.shared.u32 %r10, [acc+8];
    st.global.u32 [%rd6+44], %r10;
$Ldone:
    ret;
}
