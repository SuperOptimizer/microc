// Half precision arithmetic: f16, bf16 and the packed pair f16x2 (the values are in the comments of gen.py's style: 1.5, 2, 1).
//! run k 1 1 1 1 1 1 0 8
.version 8.5
.target sm_90
.address_size 64
.visible .entry k(.param .u64 out)
{
    .reg .b16 %a, %b, %c, %x;
    .reg .b32 %r, %v, %w;
    .reg .b64 %o;
    .reg .pred %p;
    ld.param.u64 %o, [out];
    mov.b16 %a, 0x3e00;
    mov.b16 %b, 0x4000;
    mov.b16 %c, 0x3c00;
    add.rn.f16 %x, %a, %b;
    cvt.u32.u16 %r, %x; st.global.u32 [%o], %r;
    mul.rn.f16 %x, %a, %b;
    cvt.u32.u16 %r, %x; st.global.u32 [%o+4], %r;
    fma.rn.f16 %x, %a, %b, %c;
    cvt.u32.u16 %r, %x; st.global.u32 [%o+8], %r;
    sub.rn.bf16 %x, %a, %b;
    cvt.u32.u16 %r, %x; st.global.u32 [%o+12], %r;
    mov.b32 %v, 0x3e004000;
    mov.b32 %w, 0x3c003c00;
    add.rn.f16x2 %r, %v, %w;
    st.global.u32 [%o+16], %r;
    fma.rn.f16x2 %r, %v, %w, %w;
    st.global.u32 [%o+20], %r;
    setp.lt.f16 %p, %a, %b;
    selp.u32 %r, 1, 0, %p;
    st.global.u32 [%o+24], %r;
    max.f16 %x, %a, %b;
    cvt.u32.u16 %r, %x; st.global.u32 [%o+28], %r;
    ret;
}
