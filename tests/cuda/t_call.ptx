// Control flow and calls: functions with register and memory parameters and results, a call through a
// register, recursion, a function declared before its body, predicated instructions, exit from a callee,
// alloca and the stack pointer.
//! run calls 1 1 1 2 1 1 0 40
.version 8.5
.target sm_86
.address_size 64

.func (.reg .u32 r) addmul (.reg .u32 a, .reg .u32 b, .reg .u32 c);
.func (.param .u64 r) fact (.param .u64 n);

.func (.reg .u32 r) addmul (.reg .u32 a, .reg .u32 b, .reg .u32 c)
{
    mad.lo.u32 r, a, b, c;
    ret;
}

.func (.reg .u32 r) twice (.reg .u32 a)
{
    add.u32 r, a, a;
    ret;
}

.func (.reg .u32 r) thrice (.reg .u32 a)
{
    mul.lo.u32 r, a, 3;
    ret;
}

// n! with the parameter and the result in memory, calling itself
.func (.param .u64 r) fact (.param .u64 n)
{
    .reg .u64 %a, %b;
    .reg .pred %p;
    .param .u64 arg;
    .param .u64 res;
    ld.param.u64 %a, [n];
    setp.le.u64 %p, %a, 1;
    @%p bra $Lone;
    sub.u64 %b, %a, 1;
    st.param.u64 [arg], %b;
    call (res), fact, (arg);
    ld.param.u64 %b, [res];
    mul.lo.u64 %a, %a, %b;
    st.param.u64 [r], %a;
    ret;
$Lone:
    mov.u64 %a, 1;
    st.param.u64 [r], %a;
    ret;
}

// the sum of the words of a 16-byte structure passed by value, and a structure given back
.func (.param .align 4 .b8 r[8]) sum4 (.param .align 4 .b8 s[16], .reg .u64 scale)
{
    .reg .u32 %a, %b, %c;
    ld.param.u32 %a, [s];
    ld.param.u32 %b, [s+4];
    add.u32 %a, %a, %b;
    ld.param.u32 %b, [s+8];
    add.u32 %a, %a, %b;
    ld.param.u32 %b, [s+12];
    add.u32 %a, %a, %b;
    st.param.u32 [r], %a;
    cvt.u32.u64 %c, scale;
    mul.lo.u32 %a, %a, %c;
    st.param.u32 [r+4], %a;
    ret;
}

// stores a word and ends the thread from two calls down
.func leave (.reg .u64 p)
{
    .reg .u32 %a;
    mov.u32 %a, 0xdead;
    st.global.u32 [p], %a;
    exit;
}

.func outer (.reg .u64 p)
{
    call leave, (p);
    trap;
}

// fills n words on the stack and adds them up
.func (.reg .u32 r) stacksum (.reg .u32 n)
{
    .reg .u64 %sp, %p, %q, %bytes;
    .reg .u32 %i, %v;
    .reg .pred %c;
    stacksave.u64 %sp;
    mul.wide.u32 %bytes, n, 4;
    alloca.u64 %p, %bytes, 16;
    mov.u32 %i, 0;
$L0:
    setp.ge.u32 %c, %i, n;
    @%c bra $L1;
    mul.wide.u32 %q, %i, 4;
    add.u64 %q, %q, %p;
    mul.lo.u32 %v, %i, %i;
    st.local.u32 [%q], %v;
    add.u32 %i, %i, 1;
    bra $L0;
$L1:
    mov.u32 r, 0;
    mov.u32 %i, 0;
$L2:
    setp.ge.u32 %c, %i, n;
    @%c bra $L3;
    mul.wide.u32 %q, %i, 4;
    add.u64 %q, %q, %p;
    ld.local.u32 %v, [%q];
    add.u32 r, r, %v;
    add.u32 %i, %i, 1;
    bra.uni $L2;
$L3:
    and.b64 %q, %p, 15;
    cvt.u32.u64 %v, %q;
    add.u32 r, r, %v;
    stackrestore.u64 %sp;
    ret;
}

.visible .entry calls(.param .u64 out)
{
    .reg .b32 %r<12>;
    .reg .b64 %rd<12>;
    .reg .pred %p<4>;
    ld.param.u64 %rd1, [out];
    mov.u32 %r1, %tid.x;
    mul.wide.u32 %rd2, %r1, 80;
    add.u64 %rd1, %rd1, %rd2;
    // 0: 5 * 7 + tid
    {
        .reg .u32 t;
        mov.u32 t, 7;
        call (%r2), addmul, (5, t, %r1);
    }
    st.global.u32 [%rd1], %r2;
    // 1: through a register: twice for thread 0, thrice for thread 1
    mov.u64 %rd3, twice;
    mov.u64 %rd4, thrice;
    setp.eq.u32 %p1, %r1, 0;
    selp.u64 %rd5, %rd3, %rd4, %p1;
    {
    Fproto: .callprototype (.reg .u32 _) _ (.reg .u32 _);
        call (%r3), %rd5, (%r2), Fproto;
    }
    st.global.u32 [%rd1+4], %r3;
    // 2, 3: 12! + tid ... as 64 bits
    {
        .param .u64 a0;
        .param .u64 r0;
        mov.u64 %rd6, 12;
        cvt.u64.u32 %rd7, %r1;
        add.u64 %rd6, %rd6, %rd7;
        st.param.u64 [a0], %rd6;
        call (r0), fact, (a0);
        ld.param.u64 %rd6, [r0];
    }
    st.global.u64 [%rd1+8], %rd6;
    // 4, 5: a structure by value
    {
        .param .align 4 .b8 s0[16];
        .param .align 4 .b8 r0[8];
        mov.u32 %r4, 10;
        st.param.u32 [s0], %r4;
        st.param.u32 [s0+4], %r4;
        st.param.u32 [s0+8], %r1;
        mov.u32 %r4, 1000;
        st.param.u32 [s0+12], %r4;
        mov.u64 %rd8, 3;
        call (r0), sum4, (s0, %rd8);
        ld.param.u32 %r5, [r0];
        ld.param.u32 %r6, [r0+4];
    }
    st.global.u32 [%rd1+16], %r5;
    st.global.u32 [%rd1+20], %r6;
    // 6: predicated instructions that are not branches
    mov.u32 %r7, 1;
    setp.eq.u32 %p2, %r1, 1;
    @%p2 add.u32 %r7, %r7, 10;
    @!%p2 add.u32 %r7, %r7, 100;
    @%p2 st.global.u32 [%rd1+28], %r7;
    st.global.u32 [%rd1+24], %r7;
    // 8: alloca
    add.u32 %r8, %r1, 10;
    call (%r9), stacksum, (%r8);
    st.global.u32 [%rd1+32], %r9;
    // 9: predicates as values
    setp.gt.u32 %p1, %r1, 0;
    setp.lt.u32 %p2, %r1, 5;
    and.pred %p3, %p1, %p2;
    xor.pred %p3, %p3, %p2;
    not.pred %p3, %p3;
    or.pred %p3, %p3, %p1;
    selp.u32 %r10, 7, 9, %p3;
    mov.pred %p3, %p1;
    selp.u32 %r11, 0x10, 0x20, %p3;
    or.b32 %r10, %r10, %r11;
    st.global.u32 [%rd1+36], %r10;
    // 10: the end of the thread, from inside
    add.u64 %rd9, %rd1, 40;
    call outer, (%rd9);
    mov.u32 %r1, 0xbad;
    st.global.u32 [%rd1+40], %r1;
    ret;
}
