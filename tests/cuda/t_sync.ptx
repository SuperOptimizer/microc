// Special registers, warp instructions (shfl, vote, match, redux, activemask) and barriers.
//! run special 2 2 1 3 2 2 0 192
//! run warp 1 1 1 48 1 1 0 768
//! run barrier 2 1 1 64 1 1 0 16
.version 8.5
.target sm_86
.address_size 64

// 4 words a thread, at 16 * (12 * block + thread)
.visible .entry special(.param .u64 out)
{
    .reg .b32 %r<16>;
    .reg .b64 %rd<8>;
    ld.param.u64 %rd1, [out];
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, %tid.y;
    mov.u32 %r3, %tid.z;
    mov.u32 %r4, %ntid.x;
    mov.u32 %r5, %ntid.y;
    mov.u32 %r6, %ntid.z;
    mov.u32 %r7, %ctaid.x;
    mov.u32 %r8, %ctaid.y;
    mov.u32 %r9, %nctaid.x;
    // thread = x + nx * (y + ny * z), block = bx + nbx * by
    mad.lo.u32 %r10, %r3, %r5, %r2;
    mad.lo.u32 %r10, %r10, %r4, %r1;
    mad.lo.u32 %r11, %r8, %r9, %r7;
    mad.lo.u32 %r11, %r11, 12, %r10;
    mul.wide.u32 %rd2, %r11, 16;
    add.u64 %rd1, %rd1, %rd2;
    shl.b32 %r2, %r2, 8;
    shl.b32 %r3, %r3, 16;
    mov.u32 %r12, %laneid;
    shl.b32 %r12, %r12, 24;
    or.b32 %r1, %r1, %r2;
    or.b32 %r1, %r1, %r3;
    or.b32 %r1, %r1, %r12;
    st.global.u32 [%rd1], %r1;
    shl.b32 %r8, %r8, 8;
    mov.u32 %r12, %warpid;
    shl.b32 %r12, %r12, 16;
    // %nwarpid is the device's (48 on an RTX PRO 4000, sm_120) and here the block's: at least 1 is all that is said
    mov.u32 %r13, %nwarpid;
    min.u32 %r13, %r13, 1;
    shl.b32 %r13, %r13, 24;
    or.b32 %r7, %r7, %r8;
    or.b32 %r7, %r7, %r12;
    or.b32 %r7, %r7, %r13;
    st.global.u32 [%rd1+4], %r7;
    shl.b32 %r5, %r5, 8;
    shl.b32 %r6, %r6, 16;
    or.b32 %r4, %r4, %r5;
    or.b32 %r4, %r4, %r6;
    st.global.u32 [%rd1+8], %r4;
    mov.u32 %r14, %nctaid.y;
    shl.b32 %r14, %r14, 8;
    mov.u32 %r15, %nctaid.z;
    shl.b32 %r15, %r15, 16;
    or.b32 %r9, %r9, %r14;
    or.b32 %r9, %r9, %r15;
    mov.u32 %r14, %lanemask_lt;
    popc.b32 %r14, %r14;
    shl.b32 %r14, %r14, 24;
    or.b32 %r9, %r9, %r14;
    st.global.u32 [%rd1+12], %r9;
    ret;
}

// 48 threads: a full warp and half a warp. 16 words a thread.
.visible .entry warp(.param .u64 out)
{
    .reg .b32 %r<24>;
    .reg .b64 %rd<8>;
    .reg .pred %p<6>;
    ld.param.u64 %rd1, [out];
    mov.u32 %r1, %tid.x;
    mul.wide.u32 %rd2, %r1, 64;
    add.u64 %rd1, %rd1, %rd2;
    activemask.b32 %r2;
    st.global.u32 [%rd1+60], %r2;                       // 15: ffffffff, 0000ffff
    mad.lo.u32 %r3, %r1, 3, 1;                          // the value: 3 tid + 1
    // 0, 1: up by 1 in groups of 8, and whether it came from another lane
    shfl.sync.up.b32 %r4|%p1, %r3, 1, 0x1800, %r2;
    st.global.u32 [%rd1], %r4;
    selp.u32 %r5, 1, 0, %p1;
    st.global.u32 [%rd1+4], %r5;
    // 2: down by 2 in groups of 8
    shfl.sync.down.b32 %r4|%p1, %r3, 2, 0x181f, %r2;
    selp.u32 %r5, 0x80000000, 0, %p1;
    or.b32 %r4, %r4, %r5;
    st.global.u32 [%rd1+8], %r4;
    // 3: the neighbour
    shfl.sync.bfly.b32 %r4, %r3, 1, 0x1f, %r2;
    st.global.u32 [%rd1+12], %r4;
    // 4: lane 2 of each group of 4
    shfl.sync.idx.b32 %r4, %r3, 2, 0x1c1f, %r2;
    st.global.u32 [%rd1+16], %r4;
    // 5..8: votes
    setp.lt.u32 %p2, %r1, 40;
    vote.sync.all.pred %p3, %p2, %r2;
    selp.u32 %r5, 1, 0, %p3;
    st.global.u32 [%rd1+20], %r5;
    setp.eq.u32 %p2, %r1, 33;
    vote.sync.any.pred %p3, %p2, %r2;
    selp.u32 %r5, 1, 0, %p3;
    st.global.u32 [%rd1+24], %r5;
    setp.lt.u32 %p2, %r1, 32;
    vote.sync.uni.pred %p3, %p2, %r2;
    selp.u32 %r5, 1, 0, %p3;
    setp.lt.u32 %p2, %r1, 5;
    vote.sync.uni.pred %p3, %p2, %r2;
    selp.u32 %r6, 2, 0, %p3;
    or.b32 %r5, %r5, %r6;
    st.global.u32 [%rd1+28], %r5;
    and.b32 %r6, %r1, 1;
    setp.ne.u32 %p2, %r6, 0;
    vote.sync.ballot.b32 %r5, %p2, %r2;
    st.global.u32 [%rd1+32], %r5;
    // 9: the lanes with the same (tid >> 2) & 3
    shr.u32 %r6, %r1, 2;
    and.b32 %r6, %r6, 3;
    match.any.sync.b32 %r5, %r6, %r2;
    st.global.u32 [%rd1+36], %r5;
    // 10: all the same (64 bits), 11: not all the same
    mov.u64 %rd3, 0x700000007;
    match.all.sync.b64 %r5|%p4, %rd3, %r2;
    selp.u32 %r7, 0x80000000, 0, %p4;
    xor.b32 %r5, %r5, %r7;
    st.global.u32 [%rd1+40], %r5;
    match.all.sync.b32 %r5|%p4, %r1, %r2;
    selp.u32 %r7, 0x80000000, 0, %p4;
    or.b32 %r5, %r5, %r7;
    st.global.u32 [%rd1+44], %r5;
    // 12: the sum of tid over the warp
    redux.sync.add.s32 %r5, %r1, %r2;
    st.global.u32 [%rd1+48], %r5;
    // 13: only the even lanes take part in a ballot of lane < 8; the odd ones take the largest 37 tid mod 17 among them
    and.b32 %r8, %r1, 1;
    setp.ne.u32 %p5, %r8, 0;
    @%p5 bra $Lodd;
    and.b32 %r9, %r2, 0x55555555;
    mov.u32 %r10, %laneid;
    setp.lt.u32 %p2, %r10, 8;
    vote.sync.ballot.b32 %r5, %p2, %r9;
    bra $Ljoin;
$Lodd:
    and.b32 %r9, %r2, 0xaaaaaaaa;
    mul.lo.u32 %r10, %r1, 37;
    rem.u32 %r10, %r10, 17;
    redux.sync.max.u32 %r5, %r10, %r9;
$Ljoin:
    st.global.u32 [%rd1+52], %r5;
    // 14: and, or, xor, min of 3 tid + 1 over the warp, a byte each
    redux.sync.and.b32 %r5, %r3, %r2;
    redux.sync.or.b32 %r6, %r3, %r2;
    redux.sync.xor.b32 %r7, %r3, %r2;
    redux.sync.min.s32 %r8, %r3, %r2;
    and.b32 %r6, %r6, 0xff;
    shl.b32 %r6, %r6, 8;
    and.b32 %r7, %r7, 0xff;
    shl.b32 %r7, %r7, 16;
    shl.b32 %r8, %r8, 24;
    or.b32 %r5, %r5, %r6;
    or.b32 %r5, %r5, %r7;
    or.b32 %r5, %r5, %r8;
    st.global.u32 [%rd1+56], %r5;
    ret;
}

.shared .align 4 .u32 box[4];

// 64 threads in two warps; 8 words a block
.visible .entry barrier(.param .u64 out)
{
    .reg .b32 %r<16>;
    .reg .b64 %rd<8>;
    .reg .pred %p<6>;
    ld.param.u64 %rd1, [out];
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, %ctaid.x;
    mul.wide.u32 %rd2, %r2, 32;
    add.u64 %rd1, %rd1, %rd2;
    setp.ge.u32 %p1, %r1, 32;
    @%p1 bra $Lproducer;
    // the first warp waits at barrier 1 for the 32 of the second, which only arrive
    bar.sync 1, 64;
    ld.shared.u32 %r3, [box];
    setp.ne.u32 %p2, %r1, 0;
    @%p2 bra $Lcommon;
    st.global.u32 [%rd1], %r3;                         // 0: 1000 + block
    bra $Lcommon;
$Lproducer:
    setp.ne.u32 %p2, %r1, 40;
    @%p2 bra $Larrive;
    add.u32 %r3, %r2, 1000;
    st.shared.u32 [box], %r3;
$Larrive:
    bar.arrive 1, 64;
$Lcommon:
    // every thread: how many have a tid that is a multiple of 3; whether all, whether any is above 62
    rem.u32 %r4, %r1, 3;
    setp.eq.u32 %p3, %r4, 0;
    bar.red.popc.u32 %r5, 2, %p3;
    setp.lt.u32 %p3, %r1, 64;
    bar.red.and.pred %p4, 3, %p3;
    setp.gt.u32 %p3, %r1, 62;
    bar.red.or.pred %p5, 4, %p3;
    setp.ne.u32 %p2, %r1, 17;
    @%p2 bra $Lnext;
    st.global.u32 [%rd1+4], %r5;                       // 1: 22
    selp.u32 %r6, 1, 0, %p4;
    selp.u32 %r7, 2, 0, %p5;
    or.b32 %r6, %r6, %r7;
    st.global.u32 [%rd1+8], %r6;                       // 2: 3
$Lnext:
    // the upper 16 threads leave; a barrier for everyone still lets the others through
    setp.ge.u32 %p2, %r1, 48;
    @%p2 exit;
    atom.shared.add.u32 %r8, [box+4], 1;
    bar.sync 0;
    setp.gt.u32 %p3, %r1, 40;
    bar.red.or.pred %p5, 0, %p3;
    bar.red.popc.u32 %r9, 5, %p5;
    setp.ne.u32 %p2, %r1, 5;
    @%p2 bra $Llast;
    ld.shared.u32 %r8, [box+4];
    st.global.u32 [%rd1+12], %r8;                      // 3: 48
    st.global.u32 [%rd1+16], %r9;                      // 4: 48
$Llast:
    // a barrier for the first warp alone
    setp.ge.u32 %p2, %r1, 32;
    @%p2 bra $Ldone;
    red.shared.add.u32 [box+8], %r1;
    bar.sync 6, 32;
    setp.ne.u32 %p2, %r1, 31;
    @%p2 bra $Ldone;
    ld.shared.u32 %r8, [box+8];
    st.global.u32 [%rd1+20], %r8;                      // 5: 496
$Ldone:
    ret;
}
