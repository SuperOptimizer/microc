//! run k 2 1 1 4 1 1 0 16
.version 8.5
.target sm_86
.address_size 64

.visible .entry k(.param .u64 out, .param .u64 in, .param .u32 n)
{
    .reg .u32 %r<10>;
    .reg .u64 %rd<10>;
    .reg .pred %p1;
    ld.param.u64 %rd1, [out];
    ld.param.u64 %rd2, [in];
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    mad.lo.u32 %r4, %r2, %r3, %r1;
    cvt.u64.u32 %rd3, %r4;
    shl.b64 %rd3, %rd3, 3;
    add.u64 %rd4, %rd1, %rd3;
    add.u64 %rd5, %rd2, %rd3;
    ld.global.u32 %r5, [%rd5+4];
    mov.u32 %r6, 2;
$Lsw: .branchtargets $L0, $L1, $L2, $L3;
    brx.idx %r1, $Lsw;
$L0: mov.u32 %r6, 100; bra $Ldone;
$L1: mov.u32 %r6, 101; bra $Ldone;
$L2: mov.u32 %r6, 102; bra $Ldone;
$L3: mov.u32 %r6, 103;
$Ldone:
    st.global.u32 [%rd4], %r6;
    st.global.u32 [%rd4+4], %r5;
    ret;
}
