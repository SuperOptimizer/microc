// What goes wrong inside a kernel, and how it is reported: kernel, block, thread, PTX line.
//! run nullstore 2 2 1 4 2 1 0 2
//! run trapk 1 1 1 3 1 1 0 2
//! run deadlock 1 1 1 4 1 1 0 2
//! run gone 1 1 1 32 1 1 0 2
//! run stuck 1 1 1 32 1 1 0 2
//! run mmapart 1 1 1 16 1 1 0 2
//! run badcall 1 1 1 1 1 1 0 2
//! run deep 1 1 1 1 1 1 0 2
//! run brx 1 1 1 2 1 1 0 2
//! run assert 1 1 1 1 1 1 0 2
//! run nofunc 1 1 1 1 1 1 0 2
//! run unknown 1 1 1 1 1 1 0 2
//! run fine 1 1 1 1 1 1 0 2
.version 8.5
.target sm_86
.address_size 64

.extern .func (.param .u32 r) elsewhere (.param .u32 a);
.extern .func __assertfail (.param .u64 msg, .param .u64 file, .param .u32 line, .param .u64 fn, .param .u64 csize);
.global .align 1 .b8 s_msg[6] = {120, 32, 62, 32, 48, 0};
.global .align 1 .b8 s_file[5] = {107, 46, 99, 117, 0};
.global .align 1 .b8 s_fn[2] = {107, 0};

// thread (2,1,0) of block (1,1,0) stores through a null pointer
.visible .entry nullstore(.param .u64 out)
{
    .reg .b32 %r<8>;
    .reg .b64 %rd<4>;
    .reg .pred %p<3>;
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, %tid.y;
    mov.u32 %r3, %ctaid.x;
    mov.u32 %r4, %ctaid.y;
    setp.eq.u32 %p1, %r1, 2;
    setp.eq.u32 %p2, %r2, 1;
    and.pred %p1, %p1, %p2;
    setp.eq.u32 %p2, %r3, 1;
    and.pred %p1, %p1, %p2;
    setp.eq.u32 %p2, %r4, 1;
    and.pred %p1, %p1, %p2;
    mov.u64 %rd1, 0;
    @%p1 st.global.u32 [%rd1+16], %r1;
    ret;
}

.visible .entry trapk(.param .u64 out)
{
    .reg .b32 %r1;
    .reg .pred %p1;
    mov.u32 %r1, %tid.x;
    setp.eq.u32 %p1, %r1, 1;
    @%p1 trap;
    ret;
}

// four threads wait at a barrier that wants eight
.visible .entry deadlock(.param .u64 out)
{
    bar.sync 1, 8;
    ret;
}

// lane 7 has left when the others shuffle with a mask that names it: they go on without it, as on the hardware
.visible .entry gone(.param .u64 out)
{
    .reg .b32 %r<4>;
    .reg .b64 %rd1;
    .reg .pred %p1;
    mov.u32 %r1, %tid.x;
    setp.eq.u32 %p1, %r1, 7;
    @%p1 exit;
    shfl.sync.bfly.b32 %r2, %r1, 1, 0x1f, 0xffffffff;
    setp.ne.u32 %p1, %r1, 2;
    @%p1 ret;
    ld.param.u64 %rd1, [out];
    st.global.u32 [%rd1], %r2;
    ret;
}

// lane 0 waits at a barrier nobody else comes to, the rest of the warp waits for lane 0
.visible .entry stuck(.param .u64 out)
{
    .reg .b32 %r<4>;
    .reg .pred %p1;
    mov.u32 %r1, %tid.x;
    setp.ne.u32 %p1, %r1, 0;
    @%p1 bra $L1;
    bar.sync 2, 64;
$L1:
    vote.sync.ballot.b32 %r2, %p1, 0xffffffff;
    ret;
}

// mma with half a warp
.visible .entry mmapart(.param .u64 out)
{
    .reg .b32 %a<4>, %b<2>;
    .reg .f32 %c<4>, %d<4>;
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%d0, %d1, %d2, %d3}, {%a0, %a1, %a2, %a3}, {%b0, %b1}, {%c0, %c1, %c2, %c3};
    ret;
}

// a call through a register that holds no function
.visible .entry badcall(.param .u64 out)
{
    .reg .b64 %rd1;
    .reg .b32 %r1;
    mov.u64 %rd1, 0x1234;
Fp: .callprototype (.reg .u32 _) _ (.reg .u32 _);
    call (%r1), %rd1, (%r1), Fp;
    ret;
}

.func (.reg .u32 r) down (.reg .u32 a)
{
    .local .align 8 .b8 pad[4096];
    .reg .b32 %t;
    add.u32 %t, a, 1;
    call (r), down, (%t);
    ret;
}

.visible .entry deep(.param .u64 out)
{
    .reg .b32 %r1;
    call (%r1), down, (0);
    ret;
}

.visible .entry brx(.param .u64 out)
{
    .reg .b32 %r1;
    mov.u32 %r1, %tid.x;
    add.u32 %r1, %r1, 1;
$Lt: .branchtargets $La, $Lb;
    brx.idx %r1, $Lt;
$La:
    ret;
$Lb:
    ret;
}

.visible .entry assert(.param .u64 out)
{
    .param .u64 a0;
    .param .u64 a1;
    .param .u32 a2;
    .param .u64 a3;
    .param .u64 a4;
    .reg .b64 %rd1;
    mov.u64 %rd1, s_msg;
    st.param.u64 [a0], %rd1;
    mov.u64 %rd1, s_file;
    st.param.u64 [a1], %rd1;
    st.param.u32 [a2], 42;
    mov.u64 %rd1, s_fn;
    st.param.u64 [a3], %rd1;
    mov.u64 %rd1, 1;
    st.param.u64 [a4], %rd1;
    call.uni __assertfail, (a0, a1, a2, a3, a4);
    ret;
}

// a function that no module defines: wrong only if the call is reached
.visible .entry nofunc(.param .u64 out)
{
    .param .u32 a0;
    .param .u32 r0;
    .reg .b32 %r1;
    .reg .b64 %rd1;
    ld.param.u64 %rd1, [out];
    mov.u32 %r1, 5;
    st.global.u32 [%rd1], %r1;
    st.param.u32 [a0], %r1;
    call (r0), elsewhere, (a0);
    ret;
}

// an instruction the engine does not know: the kernel does not start, the rest of the module is not touched
.visible .entry unknown(.param .u64 out)
{
    .reg .b32 %r1;
    mov.u32 %r1, 1;
    frobnicate.u32 %r1, %r1;
    ret;
}

.visible .entry fine(.param .u64 out)
{
    .reg .b64 %rd1;
    .reg .b32 %r1;
    ld.param.u64 %rd1, [out];
    mov.u32 %r1, 0x600d;
    st.global.u32 [%rd1], %r1;
    ret;
}
