// Two modules: this one calls a function and reads and writes variables that x_extlib.ptx defines.
//! with x_extlib.ptx
//! run ext 1 1 1 3 1 1 0 4
.version 8.5
.target sm_86
.address_size 64

.extern .global .align 4 .u32 libtab[4];
.extern .global .align 4 .u32 libcount;
.extern .func (.reg .u32 r) libsum (.reg .u32 n);

.visible .entry ext(.param .u64 out)
{
    .reg .b32 %r<6>;
    .reg .b64 %rd<4>;
    ld.param.u64 %rd1, [out];
    mov.u32 %r1, %tid.x;
    mul.wide.u32 %rd2, %r1, 4;
    add.u64 %rd2, %rd2, %rd1;
    add.u32 %r2, %r1, 2;
    call (%r3), libsum, (%r2);          // 33, 66, 110
    st.global.u32 [%rd2], %r3;
    bar.sync 0;
    ld.global.u32 %r4, [libcount];      // 3 calls
    ld.global.u32 %r5, [libtab+12];
    add.u32 %r4, %r4, %r5;
    st.global.u32 [%rd1+12], %r4;       // 47
    ret;
}
